# ==========================================
# Kubernetes Secrets and Sensitive Data
# ==========================================
# NEVER commit unencrypted production credentials, certificates, or tokens
*secret*.yaml
*secret*.yml
*credentials*.yaml
*credentials*.yml
.env
.env.*
*.pem
*.crt
*.key

# ==========================================
# Dynamic Local Overrides & Autogenerated Manifests
# ==========================================
# Ignore local environment overrides that shouldn't impact main branch
*.local.yaml
*.local.yml
*-local.yaml
*-local.yml

# Dry-run or rendered output files (e.g., kustomize build outputs)
rendered/
dist/
build/
*.rendered.yaml

# ==========================================
# Local Dev Tooling & Package Managers
# ==========================================
# Helm artifacts
.helm/
charts/
*.tgz
requirements.lock
values.local.yaml

# Skaffold & Devspace temporary files
.skaffold/
.devspace/

# Kubeconfig local cache (if copied to your project folder by mistake)
kubeconfig
*kubeconfig*
.kube/

# ==========================================
# SOPS (Secrets Operation) Files
# ==========================================
# If using SOPS, commit the encrypted .enc.yaml but ignore unencrypted backups
*.dec.yaml
*.dec.yml

